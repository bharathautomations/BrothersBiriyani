# Copy this file to .env for local development with `netlify dev`.
# NEVER commit a real .env file or real credentials to source control.

# PostgreSQL connection string for the bookings database.
# - If using Netlify DB (Neon integration), run `netlify db init` and Netlify
#   will inject NETLIFY_DATABASE_URL automatically for you (locally and in
#   your deployed site's environment variables).
# - If using your own Neon/PostgreSQL instance, paste its connection string
#   into one of the two variables below.
NETLIFY_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# WhatsApp Business Platform (Meta Cloud API) - optional table booking notifications.
# Leave WHATSAPP_ENABLED=false (or unset) to develop/test without ever calling the API.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
BROTHERS_BIRIYANI_WHATSAPP_NUMBER=
# Comma-separated list of up to 5 restaurant owner/staff numbers (matches the free
# WhatsApp test-number sandbox's 5-recipient limit), e.g.:
# BROTHERS_BIRIYANI_WHATSAPP_NUMBER=919876543210,919876543211
# 'template' is required for production (see README); 'text' is for local/sandbox testing only.
WHATSAPP_MESSAGE_MODE=text
WHATSAPP_RESTAURANT_TEMPLATE_NAME=
WHATSAPP_CUSTOMER_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US

