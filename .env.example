# Copy this file to .env for local development with `netlify dev`.
# NEVER commit a real .env file or real credentials to source control.

# PostgreSQL connection string for the bookings database.
# - If using Netlify DB (Neon integration), run `netlify db init` and Netlify
#   will inject NETLIFY_DATABASE_URL automatically for you (locally and in
#   your deployed site's environment variables).
# - If using your own Neon/PostgreSQL instance, paste its connection string
#   into one of the two variables below.
NETLIFY_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
